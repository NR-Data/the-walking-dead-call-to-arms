        "rules": [
          {
            "name": "Remember Your Training (Special Order)",
            "id": "e914-1b2b-5edd-83e7",
            "description": "Maggie may give 1Red to friendly Hilltop models in line of sight, at a cost of 1SP per 1Red. No more than one die may be awarded per model. Those models may add the bonus die to a single attack or defense roll in melee. Any unused dice are lost at the end of the round.",
            "hidden": false
          },
          {
            "name": "Widow",
            "id": "80cf-52be-50be-59dc",
            "description": "Maggie has the Fearless keyword as long as there is no friendly Glenn model in play.",
            "hidden": false
          }
        ],
