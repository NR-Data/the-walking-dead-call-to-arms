        "rules": [
          {
            "name": "Ugly Business (Special Order)",
            "id": "99a0-826e-c82a-2657",
            "description": "Spend 1SP to automatically remove a Prone Survivor (friend or foe) within the Kill zone of Chris or a friendly Hunter within 12\" and in line of sight of Chris. If the Survivor removed is an enemy, Chris adds 1Red to his next Attack roll. If the Survivor was a friendly model, Chris adds 1Red to his Strategy rating in the next Strategy phase. These bonuses are not cumulative (the order may be used to remove multiple Survivors from play at a cost of 1SP per model, but Chris may only benefit from one attack or Strategy rating bonus).",
            "hidden": false
          }
        ],
